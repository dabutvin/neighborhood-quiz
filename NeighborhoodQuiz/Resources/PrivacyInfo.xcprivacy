<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the app collects, said in Apple's words rather than ours: nothing.

  The map is a data file in the app bundle, fetched from NYC Open Data when a
  developer runs Tools/fetch_map_data.py and committed to the repository. There is no
  network call at runtime, no account, nothing written to the device and nothing sent
  off it. If that ever stops being true, this file is the first thing that has to change.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
